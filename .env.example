# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Midtrans Snap Payment Gateway
# MIDTRANS_SERVER_KEY: Merchant Server Key from Midtrans Dashboard (Sandbox prefix: SB-)
MIDTRANS_SERVER_KEY=""

# MIDTRANS_CLIENT_KEY: Merchant Client Key from Midtrans Dashboard (Sandbox prefix: SB-)
MIDTRANS_CLIENT_KEY=""

# MIDTRANS_IS_PRODUCTION: Set to 'true' to enable production endpoints and keys
MIDTRANS_IS_PRODUCTION=false

# PAYMENT_MODE: 'MIDTRANS' or 'MANUAL_WHATSAPP'
VITE_PAYMENT_MODE="MANUAL_WHATSAPP"
PAYMENT_MODE="MANUAL_WHATSAPP"

# WhatsApp number for mentoring contact (e.g. 6281234567890)
VITE_MENTORING_WHATSAPP_NUMBER=""
